{
  "host": "0.0.0.0",
  "port": 443,
  "status_port": 8080,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tpp-raw-telemetry",
  "transmit_decoded_records": true,
  "reliable_ack_sources": {
    "V": "pubsub",
    "alerts": "pubsub",
    "errors": "pubsub"
  },
  "pubsub": {
    "gcp_project_id": "woodhouse-506215"
  },
  "monitoring": {
    "prometheus_metrics_host": "0.0.0.0",
    "prometheus_metrics_port": 9090
  },
  "rate_limit": {
    "enabled": false
  },
  "records": {
    "V": ["pubsub"],
    "alerts": ["pubsub"],
    "errors": ["pubsub"],
    "connectivity": ["pubsub"]
  },
  "tls": {
    "server_cert": "/etc/fleet-telemetry/tls/fullchain.pem",
    "server_key": "/etc/fleet-telemetry/tls/privkey.pem"
  }
}
