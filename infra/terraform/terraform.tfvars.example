project_id = "woodhouse-506215"

# Enable only after the Phase 7 DNS/TLS operator checkpoint is complete. The
# first deployment is submitted manually; later main merges auto-deploy edge
# changes by exact image digest.
enable_telemetry_edge_delivery = false
telemetry_hostname             = "telemetry.woodhouse.derekjass.com"
# Enable only after adding a zone-scoped token to cloudflare-dns-api-token.
# Keep the schedule paused through the first reviewed manual job execution.
# enable_telemetry_certificate_automation = true
# telemetry_certificate_acme_email        = "operator@example.com"
# telemetry_certificate_schedule_paused   = true
region     = "us-central1"
zone       = "us-central1-a"

# The interactive GitHub App connection is bootstrapped once outside Terraform;
# Terraform owns the PR and main-branch triggers that reference this repository.
cloud_build_repository = "projects/woodhouse-506215/locations/us-central1/connections/tpp-github/repositories/Jazzer360-woodhouse"

# Phase 6.1: Auth0 is the documented OAuth 2.1 broker with Google upstream.
# Add the browser application secret only to platform-oidc-client-secret.
# enable_platform_oidc         = true
# platform_oidc_issuer         = "https://tenant.us.auth0.com/"
# platform_oidc_resource_url   = "https://woodhouse.derekjass.com/mcp"
# platform_oidc_client_id      = "replace-with-auth0-browser-client-id"
# platform_oidc_redirect_uri   = "https://woodhouse.derekjass.com/auth/callback"
# enable_mcp_external_access = true

# Legacy direct Google ID-token audience; do not use as the ChatGPT OAuth contract.
# oidc_audience = "replace-with-google-oauth-client-id"

# Enable only after these Secret Manager containers have enabled versions:
# tesla-client-secret, tesla-command-public-key, tesla-token-encryption-key.
# enable_tesla_onboarding  = true
# tesla_client_id          = "replace-with-tesla-application-client-id"
# tesla_app_domain         = "woodhouse.derekjass.com"
# tesla_oauth_redirect_uri = "https://woodhouse.derekjass.com/oauth/callback"

# Phase 6: enable only after adding command-proxy TLS secret versions. Resolve
# the current official image digest out of band; never deploy a floating tag.
# enable_tesla_command_proxy = true
# tesla_command_proxy_image  = "tesla/vehicle-command@sha256:<reviewed-64-hex-digest>"

# Use IAM member syntax. Keep empty until the operator identity is known.
# admin_principals = ["user:operator@example.com"]

# Operators allowed to impersonate the keyless add-user/disable-user identity.
# user_admin_principals = ["user:operator@example.com"]

# Operators allowed to impersonate only the Tesla partner-registration identity.
# partner_admin_principals = ["user:operator@example.com"]

# Add existing Monitoring notification-channel resource names when available.
# monitoring_notification_channels = [
#   "projects/woodhouse-506215/notificationChannels/1234567890",
# ]
